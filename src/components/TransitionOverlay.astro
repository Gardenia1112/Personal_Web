---
// 渐黑转场遮罩（D5 / D6）——首页 3D、about、desktop 与 BaseLayout 四处各引一次
// inline 脚本必须在首屏绘制前跑，才能让黑幕跨页衔接；JS 不可用时标记读不到，遮罩保持透明，页面照常可见
// 昼夜主题（D7）也搭这趟车：这是唯一被全部四个入口引用、且在首屏绘制前执行的组件，能避免切页闪色
---
<div id="transition-overlay" aria-hidden="true"></div>
<script is:inline>
  try {
    if (sessionStorage.getItem("lszbf:tx") === "1") {
      document.documentElement.classList.add("tx-covered");
      sessionStorage.removeItem("lszbf:tx");
    }
  } catch (err) {
    /* sessionStorage 不可用 */
  }
  try {
    var saved = localStorage.getItem("lszbf:theme");
    document.documentElement.dataset.theme = saved === "light" ? "light" : "dark";
  } catch (err) {
    /* localStorage 不可用，默认深色 */
  }
  // /desktop 选择台的两条换页路径不走渐黑，各自留一个入场标记（keyframes 在 global.css）
  try {
    var enter = sessionStorage.getItem("lszbf:dtx");
    if (enter === "rise" || enter === "veil" || enter === "fall") {
      document.documentElement.dataset.enter = enter;
      sessionStorage.removeItem("lszbf:dtx");
    }
  } catch (err) {
    /* sessionStorage 不可用，目标页就没有入场动画 */
  }
</script>
<script>
  import { initTransitions } from "../scripts/transition";
  initTransitions();
</script>
