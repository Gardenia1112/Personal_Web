---
// 深夜工位 3D 场景容器（仅首页加载 Three.js + room_full.glb）
// 降级：移动端 / 模型加载失败时由 desk.ts 给 <html> 加 .is-fallback，露出下面的静态菜单
import { deskObjects } from "../../data/objects";
import { profile } from "../../data/profile";

const EMOJI: Record<string, string> = {
  computer: "💻",
  gamepad: "🎮",
  filepile: "📁",
  notebook: "📓",
  lamp: "💡",
  coffee: "☕",
};

// 会跳路由的物件才算导航项：热点圆点和降级菜单都只列这些
// 台灯（切昼夜）和咖啡（彩蛋）是就地生效的动作，不进菜单，只在 3D 里 hover 发光
const navObjects = deskObjects.filter((o) => o.route.startsWith("/"));
---
<!-- 背景排版大字：位于 3D 画布之后（画布 alpha 透明），铺满视口形成前后空间感
     文案取自 profile.ts 的 heroLines；--len 是字符数，CSS 据此把每行撑满一行宽 -->
<h1 id="hero-type">
  {
    profile.heroLines.map((line) => (
      <span class="hero-line" style={`--len:${line.length}`}>
        {line}
      </span>
    ))
  }
</h1>

<div class="fixed inset-0 z-10 overflow-hidden" id="desk-scene"></div>

<!-- 热点圆点 = 导航菜单，位置由 desk.ts 每帧从 3D 投影到屏幕
     只给会跳路由的物件加圆点：台灯（切昼夜）和咖啡（彩蛋）不是导航项，留给鼠标扫到时自己发光 -->
<div id="hotspots">
  {
    navObjects.map((o) => (
      <button class="hotspot" type="button" data-id={o.id} aria-label={o.title}>
        <span class="hotspot-dot"></span>
        <span class="hotspot-label">{o.title}</span>
      </button>
    ))
  }
</div>

<div id="loading-hint">加载工位模型…</div>
<div id="intro-hint">鼠标靠近发光图标探索工位</div>
<div id="intro-overlay"></div>

<!-- 静态导航菜单：移动端降级 + 3D 不可用时的兜底（保留核心路由，不白屏） -->
<div class="mobile-fallback">
  <h1 class="mobile-fallback-title">{profile.name} · {profile.jobTitle}</h1>
  <p class="mobile-fallback-sub">深夜工位 · 物件即导航（静态导航模式）</p>
  <nav class="mobile-fallback-nav">
    {
      navObjects.map((o) => (
        <a href={o.route} class="mobile-fallback-link">
          <span class="mobile-fallback-emoji">{EMOJI[o.id] ?? "📦"}</span>
          <span>{o.title}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  import { initDesk } from "../../scripts/desk";
  const el = document.getElementById("desk-scene");
  // 3D 仅在桌面/平板（>=640px）初始化；手机由 .home-sections 2D 壳接管，不加载 13MB 模型。
  // 手机竖屏→横屏跨越 640px 时懒启动一次（started 防重复绑定）。
  const mq = window.matchMedia("(min-width: 640px)");
  let started = false;
  function maybeStart() {
    if (!el || started || !mq.matches) return;
    started = true;
    initDesk(el);
  }
  maybeStart();
  mq.addEventListener("change", maybeStart);
</script>
