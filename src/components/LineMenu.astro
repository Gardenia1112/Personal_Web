---
// Codrops Line Menu Styles · Alonso + 手机汉堡抽屉
import "../styles/line-menu.css";

export type LineMenuTheme = "home" | "about" | "desktop" | "awards" | "contact";
export type LineMenuCurrent = "home" | "about" | "desktop" | "awards" | "contact";

interface Props {
  current: LineMenuCurrent;
  theme: LineMenuTheme;
}

const { current, theme } = Astro.props;

const links: { id: LineMenuCurrent; href: string; label: string }[] = [
  { id: "home", href: "/", label: "主页" },
  { id: "about", href: "/about/", label: "关于我" },
  { id: "desktop", href: "/desktop/", label: "桌面" },
  { id: "awards", href: "/awards/", label: "获奖" },
  { id: "contact", href: "/contact/", label: "联系我" },
];
---
<div class="lm-bar" data-lm-theme={theme}>
  <button
    class="menu-toggle"
    type="button"
    aria-label="打开菜单"
    aria-expanded="false"
    aria-controls="lm-drawer"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav class="menu menu--alonso" aria-label="站点索引">
    <ul class="menu__list">
      {
        links.map((l) => (
          <li class:list={["menu__item", { "menu__item--current": l.id === current }]}>
            <a class="menu__link" href={l.href}>{l.label}</a>
          </li>
        ))
      }
      <li class="menu__line" aria-hidden="true"></li>
    </ul>
  </nav>
</div>

<!-- 手机侧滑抽屉：root 级定位，脱离 .lm-bar 的 pointer-events: none 与 48 层级 -->
<div class="lm-drawer" id="lm-drawer" aria-hidden="true">
  <nav aria-label="移动端站点索引">
    <ul class="lm-drawer__list">
      {
        links.map((l) => (
          <li>
            <a class:list={["lm-drawer__link", { "is-current": l.id === current }]} href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
<div class="lm-backdrop" aria-hidden="true"></div>

<script>
  import { initLineMenu } from "../scripts/line-menu";
  initLineMenu();

  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const drawer = document.getElementById("lm-drawer");
  const backdrop = document.querySelector<HTMLElement>(".lm-backdrop");
  if (toggle && drawer && backdrop) {
    const links = [...drawer.querySelectorAll<HTMLAnchorElement>("a[href]")];
    const setOpen = (open: boolean) => {
      const wasOpen = drawer.classList.contains("is-open");
      drawer.classList.toggle("is-open", open);
      backdrop.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      drawer.setAttribute("aria-hidden", String(!open));
      document.documentElement.classList.toggle("lm-open", open);
      // 焦点管理：打开聚焦首项，关闭聚焦回汉堡按钮
      const first = links[0];
      if (open && !wasOpen && first) first.focus();
      else if (!open && wasOpen) toggle.focus();
    };
    toggle.addEventListener("click", () => setOpen(!drawer.classList.contains("is-open")));
    backdrop.addEventListener("click", () => setOpen(false));
    links.forEach((a) => a.addEventListener("click", () => setOpen(false)));
    // Esc 关闭
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("is-open")) setOpen(false);
    });
    // 简易 focus-trap：Tab 困在抽屉内首尾循环
    drawer.addEventListener("keydown", (e) => {
      if (e.key !== "Tab" || !drawer.classList.contains("is-open")) return;
      const first = links[0];
      const last = links[links.length - 1];
      if (!first || !last) return;
      const active = document.activeElement;
      if (!drawer.contains(active)) {
        e.preventDefault();
        (e.shiftKey ? last : first).focus();
      } else if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
