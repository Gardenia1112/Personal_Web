---
import { artworks } from "../data/art";
---
<div class="ag" data-art-gallery>
  <header class="ag-bar">
    <p class="ag-kicker"><b>02</b> Art</p>
    <p class="ag-hint">Scroll / Drag</p>
  </header>

  <div class="ag-viewport" tabindex="0" role="group" aria-label="美术分类">
    <div class="ag-track">
      {
        artworks.map((a, i) => (
          <a
            class="ag-item"
            href={`/art/${a.slug}`}
            data-ag-item
            data-no-transition
          >
            <span class="ag-media">
              {a.cover ? (
                <img class="ag-img" src={a.cover} alt="" draggable="false" />
              ) : (
                <span class="ag-ph" aria-hidden="true">
                  <span class="ag-ph-num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="ag-ph-title">{a.name}</span>
                  <span class="ag-ph-sub">
                    {a.category} · {a.pieces.length}
                    {a.pieces[0]?.kind === "video" ? " 支" : " 件"}
                  </span>
                </span>
              )}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</div>
