---
// /desktop：三图标选择台 + 红/黄文件夹叠层（奖项已迁工位，见 6F'）
import TransitionOverlay from "./TransitionOverlay.astro";
import CustomCursor from "./CustomCursor.astro";
import LineMenu from "./LineMenu.astro";
import EntryArt from "./Desktop/EntryArt.astro";
import DevIndex from "./DevIndex.astro";
import ArtGallery from "./ArtGallery.astro";
import "../styles/global.css";
import "../styles/desktop.css";
import "../styles/dev-index.css";
import "../styles/art-gallery.css";
import "../styles/thumbfull.css";
import { desktopEntries } from "../data/desktop";
import { projects } from "../data/projects";
import { artworks } from "../data/art";
import { profile } from "../data/profile";

interface Props {
  initialFolder?: "dev" | "art";
  title?: string;
}

const { initialFolder, title = "入口 · yb-design" } = Astro.props;

const ART_TONE: Record<string, string> = {
  绘画: "is-red",
  设计: "is-amber",
  剪辑: "is-green",
  "流浪尸潮 UI/场景素材": "is-green",
};

function shortTip(name: string) {
  return name.split(/[：/（]/)[0].replace(/虚拟仿真实验$/, "").trim();
}

const FOLDER_THUMBS: Record<string, { src?: string; tone?: string; alt?: string }[]> = {
  works: projects.map((p) => ({ src: p.media?.cover, tone: "is-red", alt: p.name })),
  art: artworks.map((a) => ({ src: a.cover, tone: ART_TONE[a.category], alt: a.name })),
};
---
<!doctype html>
<html lang="zh-CN" data-page="desktop" data-initial-folder={initialFolder} class:list={[{ "is-folder-open": Boolean(initialFolder) }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${profile.name} · 项目 / 美术 / 博客三个入口`} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Dancing+Script:ital,wght@1,700&family=Great+Vibes&family=Ma+Shan+Zheng&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <link rel="canonical" href={`https://[TARGET_DOMAIN]${Astro.url.pathname}`} />
    <meta property="og:url" content={`https://[TARGET_DOMAIN]${Astro.url.pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={`${profile.name} · 项目 / 美术 / 博客三个入口`} />
    <meta property="og:image" content="/assets/art/辽大IP/logo.png" />
    <script is:inline>
      try {
        var pending = sessionStorage.getItem("yb-design:folder");
        if (pending === "dev" || pending === "art") {
          document.documentElement.classList.add("is-folder-open", "is-folder-return");
          document.documentElement.dataset.returnFolder = pending;
          sessionStorage.removeItem("yb-design:dtx");
        }
      } catch (err) {}
    </script>
  </head>
  <body>
    <LineMenu current="desktop" theme="desktop" />
    <a class="dt-home" href="/" aria-label="回工位">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <main class="dt-stage" id="dt-stage">
      <div class="dt-welcome" aria-hidden="true">
        <img class="dt-welcome-hero" src="/assets/desktop/welcome-balloon.png" alt="" />
      </div>
      <ul class="dt-cards" id="dt-shelf">
        {
          desktopEntries.map((e) => (
            <li>
              <button
                class="dt-card"
                type="button"
                data-entry={e.id}
                data-open-folder={e.id === "works" ? "dev" : e.id === "art" ? "art" : undefined}
                data-label={e.label}
                data-kicker={e.kicker}
                data-tip={e.tip}
                aria-label={e.action === "pop" ? `${e.label}，点击进入目录` : e.action === "easter" ? `${e.label}，敬请期待` : (e.tip ?? e.label)}
              >
                <EntryArt
                  art={e.art}
                  label={e.art !== "logo" ? e.label : undefined}
                  thumbs={FOLDER_THUMBS[e.id]}
                />
                <span class="dt-card-name">{e.label}</span>
              </button>
              {
                e.id === "works" && (
                  <section class="dt-pop" data-pop="works" hidden>
                    <div class="dt-fan">
                      {
                        projects.slice(0, 6).map((p) => (
                          <a
                            class="dt-fan-item"
                            href={`/works/${p.slug}`}
                            data-no-transition
                            data-rise
                            data-tip={shortTip(p.name)}
                            aria-label={p.name}
                          >
                            {p.media?.cover ? (
                              <span class="dt-fan-thumb">
                                <img src={p.media.cover} alt={p.name} loading="lazy" />
                              </span>
                            ) : (
                              <span class="dt-fan-thumb is-blank is-red">
                                <span>PROJECT</span>
                              </span>
                            )}
                          </a>
                        ))
                      }
                    </div>
                  </section>
                )
              }
              {
                e.id === "art" && (
                  <section class="dt-pop" data-pop="art" hidden>
                    <div class="dt-fan">
                      {
                        artworks.slice(0, 6).map((a) => (
                          <a
                            class="dt-fan-item"
                            href={`/art/${a.slug}`}
                            data-no-transition
                            data-rise
                            data-tip={a.category}
                            aria-label={a.name}
                          >
                            {a.cover ? (
                              <span class="dt-fan-thumb">
                                <img src={a.cover} alt={a.name} loading="lazy" />
                              </span>
                            ) : (
                              <span class:list={["dt-fan-thumb", "is-blank", ART_TONE[a.category]]}>
                                <span>{a.category}</span>
                              </span>
                            )}
                          </a>
                        ))
                      }
                    </div>
                  </section>
                )
              }
            </li>
          ))
        }
      </ul>
    </main>

    <div class="dt-card-tip" id="dt-card-tip" aria-hidden="true"></div>

    <div class:list={["dt-folder-layer", { "is-in": Boolean(initialFolder) }]} id="dt-folder-layer" data-folder-layer hidden={!initialFolder}>
      <button type="button" class="dt-folder-close" data-folder-close aria-label="关闭文件夹" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="dt-folder-view" data-folder-view="dev" hidden={initialFolder !== "dev"}>
        <DevIndex />
      </div>
      <div class="dt-folder-view" data-folder-view="art" hidden={initialFolder !== "art"}>
        <ArtGallery />
      </div>
    </div>
    <script is:inline>
      try {
        var back = document.documentElement.dataset.returnFolder;
        if (back === "dev" || back === "art") {
          var layer = document.getElementById("dt-folder-layer");
          if (layer) {
            layer.hidden = false;
            layer.classList.remove("is-in", "is-out");
            layer.querySelectorAll("[data-folder-view]").forEach(function (view) {
              view.hidden = view.getAttribute("data-folder-view") !== back;
            });
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                layer.classList.add("is-in");
              });
            });
          }
        }
      } catch (err) {}
    </script>

    <script>
      import { initFolderViews } from "../scripts/desktop/folder-views";
      initFolderViews();
    </script>
    <script>
      import { initDesktop } from "../scripts/desktop/desktop";
      const stage = document.getElementById("dt-stage");
      if (stage) initDesktop(stage);
    </script>
    <TransitionOverlay />
    <CustomCursor />
  </body>
</html>
