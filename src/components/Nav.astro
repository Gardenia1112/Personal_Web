---
// 顶部兜底导航（3D 工位不可用时用，二级页面显示）
const links = [
  { href: "/", label: "首页" },
  { href: "/about", label: "关于我" },
  { href: "/works", label: "作品" },
  { href: "/awards", label: "获奖" },
  { href: "/blog", label: "博客" },
  { href: "/contact", label: "联系" },
];
const path = Astro.url.pathname;
---
<nav class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between px-6 py-3 bg-[#0f1115]/80 backdrop-blur border-b border-white/10">
  <a href="/" class="font-bold text-lg tracking-wide text-[#00d9ff]">lszbf.com</a>
  <div class="flex gap-5 text-sm">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "transition-colors",
            path === l.href ? "text-[#00d9ff]" : "text-white/70 hover:text-white",
          ]}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>
