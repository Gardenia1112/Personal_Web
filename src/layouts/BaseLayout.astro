---
import Footer from "../components/Footer.astro";
import TransitionOverlay from "../components/TransitionOverlay.astro";
import CustomCursor from "../components/CustomCursor.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "lszbf.com",
  description = "赵彼方 · 游戏制作人的个人作品集",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Footer />
    <TransitionOverlay />
    <CustomCursor />
    <script>
      import { initMagneticButtons } from "../scripts/magnetic";
      initMagneticButtons();
    </script>
  </body>
</html>
