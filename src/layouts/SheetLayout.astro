---
// 作品 / 美术详情：浅纸底，不要 BaseLayout 那条旧顶栏
import TransitionOverlay from "../components/TransitionOverlay.astro";
import CustomCursor from "../components/CustomCursor.astro";
import "../styles/global.css";
import "../styles/paper.css";
import "../styles/project-detail.css";
import "../styles/thumbfull.css";

interface Props {
  title: string;
  tone?: "sheet" | "deep";
}

const { title, tone = "sheet" } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-page="sheet" data-tone={tone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      try {
        var raw = sessionStorage.getItem("lszbf:thumbfull");
        if (raw) {
          var data = JSON.parse(raw);
          if (data && data.slug === "wandering-corpse-tide") {
            sessionStorage.removeItem("lszbf:thumbfull");
            data = null;
          }
          if (data && data.slug) {
            sessionStorage.removeItem("lszbf:dtx");
            var root = document.documentElement;
            root.removeAttribute("data-enter");
            root.classList.add(data.expanded ? "is-thumbfull-arrive" : "is-thumbfull-slide");
            var hold = document.createElement("style");
            hold.id = "thumbfull-hold-style";
            if (data.expanded && data.src && String(data.src).charAt(0) === "/" && String(data.src).indexOf("//") !== 0) {
              var src = String(data.src).replace(/["')\\\s]/g, "");
              root.style.backgroundImage = 'url("' + src + '")';
              root.style.backgroundRepeat = "no-repeat";
              root.style.backgroundPosition = "top left";
              root.style.backgroundSize = data.full ? "100vw 100vh" : "100vw min(72vh, 820px)";
              hold.textContent =
                "html.is-thumbfull-arrive,html.is-thumbfull-arrive body{background-color:transparent!important}";
            } else {
              root.style.backgroundColor = "#f0f8ff";
              hold.textContent = "html,body{background:#f0f8ff!important}";
            }
            root.appendChild(hold);
          }
        }
      } catch (err) {}
    </script>
  </head>
  <body>
    <a class="sheet-home" href="/desktop" data-fall aria-label="回桌面">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <script is:inline>
      try {
        var from = sessionStorage.getItem("lszbf:folder");
        if (from === "dev" || from === "art") {
          var home = document.querySelector(".sheet-home");
          if (home) home.setAttribute("aria-label", "回目录");
        }
      } catch (err) {}
    </script>
    <slot />
    <TransitionOverlay />
    <CustomCursor />
  </body>
</html>
