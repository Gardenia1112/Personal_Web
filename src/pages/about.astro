---
import TransitionOverlay from "../components/TransitionOverlay.astro";
import CustomCursor from "../components/CustomCursor.astro";
import LineMenu from "../components/LineMenu.astro";
import "../styles/global.css";
import { author, profile } from "../data/profile";
import { gameBoards } from "../data/aboutGame";
---
<!doctype html>
<html lang="zh-CN" data-page="about">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content="游戏化个人介绍" />
    <title>关于我 · lszbf.com</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="关于我 · lszbf.com" />
    <meta property="og:description" content="游戏化个人介绍" />
    <meta property="og:image" content="/assets/about/now-desk-night.png" />
  </head>
  <body class="overflow-hidden">
    <LineMenu current="about" theme="about" />
    <main id="game" class="relative w-full h-screen overflow-hidden">
      <a class="about-home magnetic-btn" href="/" aria-label="回工位">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <div id="about-wipe" aria-hidden="true"></div>
      <div id="about-hint" class="about-hint is-on" aria-hidden="true">
        <p>A/D 或 ←/→ 移动</p>
      </div>
      <div id="board-panel" aria-live="polite">
        <div class="about-panel-body" id="board-panel-body"></div>
      </div>
      <a id="about-ending-cta" class="about-ending-cta magnetic-btn" href="/contact">联系我 →</a>
    </main>

    <!-- 移动端降级：静态简介。桌面端仍走 Phaser 横版小游戏（下方脚本条件加载，Phaser 不参与降级分支） -->
    <section id="about-fallback" class="about-fallback" aria-label="关于我 · 静态简介">
      <div class="about-fallback-card">
        <a class="about-fallback-back" href="/" aria-label="回工位">← 回工位</a>
        <p class="about-fallback-kicker">GAME INTRO · 关于我</p>
        <figure class="about-fallback-cover">
          <img src="/assets/about/now-desk-night.png" alt="深夜工位" />
        </figure>
        <h1 class="about-fallback-title">{author}</h1>
        <p class="about-fallback-tagline">游戏制作人 · 本科在读</p>
        <p class="about-fallback-lead">{profile.intro.tagline}</p>
        <ol class="about-fallback-chapters">
          {
            gameBoards.map((b) => (
              <li>
                <em>{String(b.index).padStart(2, "0")}</em>
                <span>{b.title}</span>
              </li>
            ))
          }
        </ol>
        <p class="about-fallback-note">桌面端可体验完整横版小游戏（A/D 或 ←/→ 移动，滚轮翻阅介绍）。</p>
        <a class="about-fallback-cta" href="/contact">联系我 →</a>
      </div>
    </section>

    <script>
      // 降级判定（对齐 desk.ts 的 degradeToFallback 触发）：粗指针 / 窄屏 / ?game=off → 加 .is-fallback，
      // 只露静态简介；只有桌面端才动态 import Phaser，避免移动端拉取并执行游戏包
      const params = new URLSearchParams(location.search);
      const fallback =
        params.get("game") === "off" ||
        window.matchMedia("(pointer: coarse)").matches ||
        window.innerWidth < 768;
      if (fallback) {
        document.documentElement.classList.add("is-fallback");
      } else {
        import("../scripts/game/game").then(({ createGameIntro }) => {
          const container = document.getElementById("game");
          const panel = document.getElementById("board-panel");
          if (container) createGameIntro(container, panel);
        });
      }
    </script>
    <TransitionOverlay />
    <CustomCursor />
  </body>
</html>
