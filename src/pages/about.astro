---
import TransitionOverlay from "../components/TransitionOverlay.astro";
import CustomCursor from "../components/CustomCursor.astro";
import LineMenu from "../components/LineMenu.astro";
import Section from "../components/about/Section.astro";
import ProgressBar from "../components/about/ProgressBar.astro";
import NowStats from "../components/about/NowStats.astro";
import "../styles/global.css";
import "../styles/about.css";
import { author, profile } from "../data/profile";
import { gameBoards } from "../data/aboutGame";

const board = (id: string) => gameBoards.find((b) => b.id === id)!;
const start = board("start");
const turning = board("turning");
const now = board("now");
const ending = board("ending");
const total = gameBoards.length;
---
<!doctype html>
<html lang="zh-CN" data-page="about">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={`关于我 · ${author}`} />
    <title>关于我 · {author}</title>
    <link rel="canonical" href={`https://[TARGET_DOMAIN]${Astro.url.pathname}`} />
    <meta property="og:url" content={`https://[TARGET_DOMAIN]${Astro.url.pathname}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`关于我 · ${author}`} />
    <meta property="og:description" content={`关于我 · ${author}`} />
    <meta property="og:image" content="/assets/art/辽大IP/logo.png" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <LineMenu current="about" theme="about" />

    <div class="about-viewport">
      <Section id="start" variant="start" kicker={start.kicker} title={start.title} cover={start.cover}>
        <ol class="about-story">
          {start.lines.map((l) => (
            <li class="about-line">{l}</li>
          ))}
        </ol>
      </Section>

      <Section id="turning" variant="turning" kicker={turning.kicker} title={turning.title} cover={turning.cover}>
        <ol class="about-story">
          {turning.lines.map((l) => (
            <li class="about-line">{l}</li>
          ))}
        </ol>
      </Section>

      <Section id="now" variant="now" kicker={now.kicker} title={now.title} tagline={now.tagline} cover={now.cover}>
        <NowStats lines={now.lines} />
      </Section>

      <Section id="ending" variant="ending" kicker={ending.kicker} title={ending.title} cover={ending.cover}>
        <div class="about-end">
          <p class="about-end-sub">{ending.subtitle}</p>
          <div class="about-end-scroll" aria-hidden="true">
            <div class="about-end-track">
              <div class="about-end-group">
                {ending.scrollTexts?.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
              <div class="about-end-group">
                {ending.scrollTexts?.map((t) => (
                  <span>{t}</span>
                ))}
              </div>
            </div>
          </div>
          <a class="about-end-cta" href={ending.cta?.href ?? "/contact"}>{ending.cta?.label ?? "联系我 →"}</a>
        </div>
      </Section>
    </div>

    <ProgressBar total={total} />
    <TransitionOverlay />
    <CustomCursor />
    <script>
      import { initAbout } from "../scripts/about";
      initAbout();
    </script>
  </body>
</html>
