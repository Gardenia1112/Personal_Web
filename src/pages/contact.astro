---
import BlogLayout from "../layouts/BlogLayout.astro";
import LineMenu from "../components/LineMenu.astro";
import { profile, author } from "../data/profile";

const links = [
  { label: "GitHub", url: profile.github, tip: "看代码与提交记录", icon: "GH", external: true },
  { label: "Gitee 源码", url: profile.gitee, tip: "部分项目镜像", icon: "GT", external: true },
  { label: "发邮件", url: `mailto:${profile.email}`, tip: "打开系统邮箱客户端", icon: "MAIL", external: false },
];

const channels = [
  { key: "email", label: "邮箱", value: profile.email, aria: "复制邮箱", hint: "首选 · 实习 / 合作 / 技术交流" },
  { key: "wechat", label: "微信", value: profile.wechat, aria: "复制微信", hint: "快速沟通" },
  { key: "phone", label: "手机", value: profile.phone, aria: "复制手机号", hint: "必要时电话联系" },
];
---
<BlogLayout title="联系我 · yb-design" description={`与${author}取得联系 · 游戏制作`} backHref="/" backLabel="回工位">
  <LineMenu current="contact" theme="contact" />
  <div class="nm-shell nm-contact">
    <header class="nm-topbar">
      <a class="nm-brand" href="/contact/">
        <span class="nm-brand-mark" aria-hidden="true">C</span>
        <span>yb-design · Contact</span>
      </a>
      <p class="nm-topbar-note">本子 · Links · 直接联系入口</p>
    </header>

    <!-- 设计思路：先讲清「我是谁 / 为什么联系」，再给出可点的主通道 -->
    <section class="nm-contact-hero" aria-labelledby="contact-hero-title">
      <div class="nm-contact-hero-cover nm-cover-1" aria-hidden="true"></div>
      <div class="nm-contact-hero-body">
        <div class="nm-contact-profile">
          <div>
            <p class="nm-contact-kicker">
              <span class="nm-badge">Open to chat</span>
            </p>
            <h1 id="contact-hero-title" class="nm-contact-title typewriter" data-tw="0">
              你好，我是{author}
            </h1>
          </div>
        </div>
        <p class="nm-contact-lede">
          联系页的意义，是让访客用自己舒服的方式找到你。下面列出邮箱、微信、手机与外链——优先邮箱；需要更快回复可加微信。
        </p>
        <div class="nm-contact-ctas">
          <a
            class="nm-contact-cta magnetic-btn"
            href={`mailto:${profile.email}`}
            data-no-transition
            aria-label={`用系统邮箱给 ${profile.email} 写信`}
          >
            写一封邮件
          </a>
          <a
            class="nm-contact-cta nm-contact-cta--ghost magnetic-btn"
            href={profile.resume}
            download
            aria-label="下载简历 resume.pdf"
          >
            下载简历
          </a>
        </div>
        <p class="nm-contact-expect">通常 24–48 小时内回复 · 欢迎聊实习机会、项目合作与游戏制作交流</p>
      </div>
    </section>

    <div class="nm-contact-grid">
      <!-- 左：联系方式（本子左页语义保留） -->
      <section class="nm-contact-card" aria-labelledby="contact-sheet-heading">
        <h2 id="contact-sheet-heading" class="nm-contact-card-title typewriter" data-tw="1">直接联系</h2>
        <p class="nm-contact-card-sub">一键复制，或点「写一封邮件」唤起系统邮箱客户端</p>
        <ul class="nm-contact-channels">
          {
            channels.map((c, i) => (
              <li class="nm-contact-channel">
                <div class="nm-contact-channel-head">
                  <span class="nm-contact-channel-label">{c.label}</span>
                  <span class="nm-contact-channel-hint">{c.hint}</span>
                </div>
                <div class="nm-contact-channel-row">
                  <code class="nm-contact-value typewriter" data-tw={String(i + 2)}>
                    {c.value}
                  </code>
                  <button
                    type="button"
                    class="nm-contact-copy"
                    data-copy={c.value}
                    data-copy-label={c.label}
                    aria-label={c.aria}
                  >
                    复制
                  </button>
                </div>
              </li>
            ))
          }
        </ul>
        <p id="contact-copy-status" class="contact-live" aria-live="polite"></p>
      </section>

      <!-- 右：外链（本子右页语义保留） -->
      <section class="nm-contact-card" aria-labelledby="contact-links-heading">
        <h2 id="contact-links-heading" class="nm-contact-card-title">外链与社交</h2>
        <p class="nm-contact-card-sub">多种通道并列，按你的习惯选择</p>
        <div class="nm-contact-links">
          {
            links.map((l) =>
              l.external ? (
                <a
                  class="nm-contact-link"
                  href={l.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${l.label}（在新标签页打开）`}
                >
                  <span class="nm-contact-link-ico" aria-hidden="true">{l.icon}</span>
                  <span class="nm-contact-link-text">
                    <strong>{l.label}</strong>
                    <small>{l.tip}</small>
                  </span>
                  <span class="nm-contact-link-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <a
                  class="nm-contact-link"
                  href={l.url}
                  data-no-transition
                  aria-label={`${l.label}（系统邮箱客户端）`}
                >
                  <span class="nm-contact-link-ico" aria-hidden="true">{l.icon}</span>
                  <span class="nm-contact-link-text">
                    <strong>{l.label}</strong>
                    <small>{l.tip}</small>
                  </span>
                  <span class="nm-contact-link-arrow" aria-hidden="true">↗</span>
                </a>
              ),
            )
          }
        </div>
      </section>
    </div>

    <p class="nm-foot">© 2026 {author}</p>
  </div>

  <script>
    // Formspree 未启用（用户裁定：使用 mailto + 剪贴板）
    // 如需启用，在此接入 fetch(endpoint)，endpoint 由 Formspree 后台获取
    const live = document.getElementById("contact-copy-status");
    document.querySelectorAll("[data-copy]").forEach((b) => {
      b.addEventListener("click", () => {
        const btn = b as HTMLElement;
        const v = btn.dataset.copy ?? "";
        const label = btn.dataset.copyLabel ?? "内容";
        navigator.clipboard?.writeText(v);
        const old = btn.textContent;
        btn.textContent = "已复制 ✓";
        btn.classList.add("copied");
        if (live) live.textContent = `已复制${label}`;
        setTimeout(() => {
          btn.textContent = old;
          btn.classList.remove("copied");
          if (live) live.textContent = "";
        }, 1200);
      });
    });

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nodes = [...document.querySelectorAll<HTMLElement>(".nm-contact .typewriter")];
    if (reduceMotion) {
      nodes.forEach((el) => el.classList.add("is-done"));
    } else {
      nodes.forEach((el) => {
        const full = el.textContent ?? "";
        const step = Number(el.dataset.tw ?? "0");
        el.textContent = "";
        el.classList.add("is-typing");
        const startAt = 160 + step * 380;
        window.setTimeout(() => {
          let i = 0;
          const tick = () => {
            i += 1;
            el.textContent = full.slice(0, i);
            if (i < full.length) {
              window.setTimeout(tick, 28);
            } else {
              el.classList.remove("is-typing");
              el.classList.add("is-done");
            }
          };
          tick();
        }, startAt);
      });
    }
  </script>
</BlogLayout>
