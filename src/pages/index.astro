---
// 首页：深夜工位 3D 场景（全屏，不使用 BaseLayout，物件即导航）
import Scene from "../components/Desk3D/Scene.astro";
import TransitionOverlay from "../components/TransitionOverlay.astro";
import CustomCursor from "../components/CustomCursor.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="赵彼方 · 游戏制作人的个人作品集" />
    <title>lszbf.com · 赵韵婷</title>
    <script is:inline>
      try {
        if (localStorage.getItem("lszbf:desk-theme") === "light") {
          document.documentElement.dataset.deskTheme = "light";
        }
      } catch (e) {}
    </script>
  </head>
  <body class="overflow-hidden">
    <Scene />
    <TransitionOverlay />
    <CustomCursor />
  </body>
</html>
