---
import SheetLayout from "../../layouts/SheetLayout.astro";
import ArtShow from "../../components/ArtShow.astro";
import { artworks } from "../../data/art";
import "../../styles/art-gallery.css";

export function getStaticPaths() {
  return artworks.map((a) => ({
    params: { slug: a.slug },
    props: { artwork: a },
  }));
}

const { artwork } = Astro.props;
---
<SheetLayout title={`${artwork.category} · yb-design`}>
  <script is:inline define:vars={{ slug: artwork.slug }}>
    try {
      var raw = sessionStorage.getItem("yb-design:thumbfull");
      if (raw) {
        var data = JSON.parse(raw);
        if (data && data.slug === slug) {
          document.documentElement.classList.add(data.expanded ? "is-thumbfull-arrive" : "is-thumbfull-slide");
        }
      }
    } catch (err) {}
  </script>
  <ArtShow artwork={artwork} />
</SheetLayout>

<script>
  import { arriveThumbFull } from "../../scripts/thumbfull";
  import { initArtShow } from "../../scripts/desktop/art-gallery";
  const root = document.querySelector<HTMLElement>("[data-art-show]");
  if (root) {
    arriveThumbFull(root.dataset.artSlug ?? "", root.querySelector("[data-thumbfull-copy]"));
    initArtShow(root);
  }
</script>
