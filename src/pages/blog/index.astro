---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts[0];

function formatDate(d: Date) {
  return d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

function coverClass(i: number) {
  return `nm-cover-${i % 3}`;
}
---
<BlogLayout title="博客 · lszbf.com" description="赵彼方 · 游戏制作笔记" backHref="/" backLabel="回工位">
  <div class="nm-shell">
    <header class="nm-topbar">
      <a class="nm-brand" href="/blog/">
        <span class="nm-brand-mark" aria-hidden="true">L</span>
        <span>lszbf · Blog</span>
      </a>
      <p class="nm-topbar-note">游戏制作笔记 · 工具链 / 性能 / 架构</p>
    </header>

    {
      featured && (
        <section class="nm-hero" aria-label="精选与热门">
          <a class="nm-featured" href={`/blog/${featured.slug}/`}>
            <div class={`nm-featured-cover ${coverClass(0)}`} aria-hidden="true" />
            <div class="nm-featured-body">
              {featured.data.tags[0] && <span class="nm-badge">{featured.data.tags[0]}</span>}
              <h1 class="nm-featured-title">{featured.data.title}</h1>
              <p class="nm-featured-desc">{featured.data.description}</p>
              <div class="nm-meta">
                <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
                {featured.data.tags.slice(1).map((tag) => (
                  <span class="nm-badge nm-badge--soft">{tag}</span>
                ))}
              </div>
            </div>
          </a>

          <aside class="nm-trending">
            <h2 class="nm-trending-title">Trending</h2>
            <ul class="nm-trending-list">
              {posts.map((post, i) => (
                <li class="nm-trending-item">
                  <a href={`/blog/${post.slug}/`}>
                    <div class={`nm-thumb ${coverClass(i)}`} aria-hidden="true" />
                    <div>
                      <h3>{post.data.title}</h3>
                      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </section>
      )
    }

    <section aria-label="全部文章">
      <div class="nm-section-head">
        <h2>Editor&apos;s Pick</h2>
        <p>{posts.length} 篇笔记</p>
      </div>
      <div class="nm-grid">
        {
          posts.map((post, i) => (
            <a class="nm-card" href={`/blog/${post.slug}/`}>
              <div class="nm-card-top">
                <span>lszbf</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              </div>
              <div class="nm-card-media">
                <div class={`nm-cover-fill ${coverClass(i)}`} aria-hidden="true" />
                {post.data.tags[0] && <span class="nm-badge">{post.data.tags[0]}</span>}
              </div>
              <div class="nm-card-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <p class="nm-foot">© 2026 赵韵婷 · lszbf.com</p>
  </div>
</BlogLayout>
