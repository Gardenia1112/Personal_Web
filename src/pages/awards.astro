---
import BaseLayout from "../layouts/BaseLayout.astro";
import { awards } from "../data/awards";
---
<BaseLayout title="获奖与证书 · lszbf.com">
  <main class="pt-24 px-6 max-w-4xl mx-auto min-h-screen">
    <h1 class="text-3xl font-bold text-[#00d9ff]">获奖与证书</h1>
    <p class="mt-4 text-white/60">占位页 —— Phase 5 将替换为「可翻页证书墙」。</p>

    <div class="mt-8 grid gap-4">
      {
        awards
          .filter((a) => a.category === "省级及以上")
          .map((a) => (
            <div class="p-4 rounded bg-white/5 border border-white/10">
              <span class="font-semibold">{a.name}</span>
              <span class="ml-3 text-[#ffb974]">{a.level}</span>
            </div>
          ))
      }
    </div>
  </main>
</BaseLayout>
