---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalGallery from "../components/HorizontalGallery.astro";
import type { GalleryItem, GalleryTab } from "../scripts/gallery";
import { awards } from "../data/awards";

// 证书墙改用同一横向视差画廊（D10）：图片证书可点击放大，PDF / Office 证书走下载
const IMAGE_EXT = ["png", "jpg", "jpeg", "gif", "webp"];

const tabs: GalleryTab[] = [
  { key: "all", label: "全部" },
  { key: "省级及以上", label: "竞赛获奖" },
  { key: "证书", label: "证书" },
];

const items: GalleryItem[] = awards.map((a) => {
  const ext = a.file?.split(".").pop()?.toLowerCase() ?? "";
  const url = a.file ? `/assets/awards/${a.file}` : undefined;
  const isImage = IMAGE_EXT.includes(ext);
  // 校级 / 院级归到「竞赛获奖」分组，默认隐藏，由开关放出（对齐 01 §6.2 用户原则）
  const group = a.category === "校级院级" ? "省级及以上" : a.category;
  return {
    id: `${a.name}-${a.level}`,
    title: a.name,
    group,
    meta: a.level,
    tag: a.category === "校级院级" ? "校级 / 院级" : a.category,
    cover: isImage ? url : undefined,
    preview: isImage ? url : undefined,
    download: isImage ? undefined : url,
    actionLabel: ext === "pdf" ? "下载 PDF" : url ? "下载文件" : undefined,
    optional: a.hide,
  };
});
---
<BaseLayout title="获奖与证书 · lszbf.com">
  <main class="gallery-page">
    <header class="gallery-page-header">
      <h1 class="gallery-page-title">获奖与证书</h1>
      <p class="gallery-page-sub">
        省级及以上竞赛、英语等级证书与软件著作权；校级 / 院级奖项默认收起，可用右侧开关放出。
      </p>
    </header>

    <HorizontalGallery
      items={items}
      tabs={tabs}
      activeKey="all"
      toggleLabel="显示校级 / 院级"
      emptyText="该分组暂无证书"
    />
  </main>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="关闭">✕</button>
    <img id="lightbox-img" src="" alt="" />
  </div>

  <script>
    // 图片证书点击放大（画廊卡片上的 [data-preview] 按钮）
    const lightbox = document.getElementById("lightbox") as HTMLElement | null;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.remove("show");
      lightbox.setAttribute("aria-hidden", "true");
      lightboxImg.src = "";
    }

    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-preview]") as HTMLElement | null;
      if (!btn || !lightbox || !lightboxImg) return;
      lightboxImg.src = btn.dataset.preview ?? "";
      lightbox.classList.add("show");
      lightbox.setAttribute("aria-hidden", "false");
    });

    document.getElementById("lightbox-close")?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeLightbox();
    });
  </script>
</BaseLayout>
