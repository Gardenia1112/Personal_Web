---
import SheetLayout from "../../layouts/SheetLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      index: i,
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, index, next } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const tags = [project.role.split("·")[0]?.trim(), project.period.match(/\d{4}/)?.[0]].filter(
  (t): t is string => Boolean(t)
);

const chapters = [
  { no: "01", label: "问题", title: "要解决什么", text: project.problem },
  { no: "02", label: "技术方案", title: "怎么搭起来", text: project.tech },
  { no: "03", label: "我的贡献", title: "我做了哪部分", text: project.contribution },
  { no: "04", label: "量化成果", title: "最后拿到什么", text: project.result },
].filter((c) => Boolean(c.text));
---
<SheetLayout title={`${project.name} · lszbf.com`}>
  <script is:inline define:vars={{ slug: project.slug }}>
    try {
      var raw = sessionStorage.getItem("lszbf:thumbfull");
      if (raw) {
        var data = JSON.parse(raw);
        if (data && data.slug === slug) {
          document.documentElement.classList.add(data.expanded ? "is-thumbfull-arrive" : "is-thumbfull-slide");
        }
      }
    } catch (err) {}
  </script>

  <article class="pd paper-page paper-page--works" data-project-slug={project.slug}>
    <header class="pd-hero">
      {
        project.media?.cover && (
          <div class="pd-hero-media thumbfull-outer" data-thumbfull-outer>
            <div class="thumbfull-inner" data-thumbfull-inner>
              <img src={project.media.cover} alt={`${project.name} 封面`} />
            </div>
          </div>
        )
      }
      <div class="pd-hero-copy" data-thumbfull-copy>
        <p class="pd-eyebrow">
          <b>{num}</b>
          {project.period}
        </p>
        {
          tags.length > 0 && (
            <ul class="pd-hero-tags">
              {tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
        <h1 class="pd-hero-title">{project.name}</h1>
        {project.problem && <p class="pd-hero-lede">{project.problem}</p>}
        {
          project.links.length > 0 && (
            <div class="pd-hero-actions">
              {project.links.map((l) => (
                <a class="pd-btn" href={l.url} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="pd-body">
      {
        chapters.map((c) => (
          <section class="pd-chapter">
            <div>
              <p class="pd-eyebrow">
                <b>{c.no}</b> {c.label}
              </p>
              <h2 class="pd-chapter-title">{c.title}</h2>
            </div>
            <div>
              <p class="pd-chapter-text">{c.text}</p>
              {c.no === "04" && project.metrics && (
                <section class="project-metrics">
                  {project.metrics.map((m) => (
                    <div class="metric">
                      <div class="metric-head">
                        <span class="metric-label">{m.label}</span>
                        <span class="metric-values">
                          {m.before} → {m.after}
                        </span>
                        <span class="metric-note">{m.note}</span>
                      </div>
                      <div class="metric-bar">
                        <i style={`width:${m.pct}%`}></i>
                      </div>
                    </div>
                  ))}
                </section>
              )}
            </div>
          </section>
        ))
      }

      {
        project.media?.arch && (
          <figure class="pd-figure">
            <img src={project.media.arch} alt={`${project.name} 架构图`} loading="lazy" />
            <figcaption>架构 / Architecture</figcaption>
          </figure>
        )
      }

      {
        project.media?.video && (
          <figure class="pd-figure">
            <video src={project.media.video} controls preload="none" playsinline></video>
            <figcaption>实机演示 / Gameplay</figcaption>
          </figure>
        )
      }

      {
        project.media?.gallery && project.media.gallery.length > 0 && (
          <figure class="pd-figure">
            <div class="pd-strip">
              {project.media.gallery.map((g) => (
                <img src={g} alt={`${project.name} 素材`} loading="lazy" />
              ))}
            </div>
            <figcaption>过程稿 / Process</figcaption>
          </figure>
        )
      }

      <nav class="pd-foot">
        <a class="pd-btn pd-btn--ghost" href={`/works/${next.slug}`}>
          {next.name} →
        </a>
      </nav>
    </div>
  </article>
</SheetLayout>

<script>
  import { arriveThumbFull } from "../../scripts/thumbfull";
  const root = document.querySelector<HTMLElement>("[data-project-slug]");
  const copy = document.querySelector<HTMLElement>("[data-thumbfull-copy]");
  arriveThumbFull(root?.dataset.projectSlug ?? "", copy);
</script>
