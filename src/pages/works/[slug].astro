  .bb-note-row.is-lead {
    border: 2px solid var(--color-sheet-blue-deep);
    background: rgba(0, 185, 232, 0.08);
  }
  .bb-note-row.is-lead::before {
    content: "★";
    color: var(--color-sheet-blue-deep);
    margin-right: 0.35em;
  }
  .bb-file-list li {
    position: relative;
  }
  .bb-section-note {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(260px, 28vw, 340px);
    max-height: 70vh;
    overflow-y: auto;
    scrollbar-width: thin;
    margin: 0;
    z-index: 50;
    pointer-events: auto;
  }
  .bb-file-list:not(.is-left) li .bb-section-note {
    left: 100%;
    right: auto;
    padding-left: 16px;
  }
  .bb-file-list.is-left li .bb-section-note {
    left: auto;
    right: 100%;
    padding-right: 16px;
  }
  @media (max-width: 900px) {
    .bb-file-list.is-left li .bb-section-note {
      left: 100%;
      right: auto;
      padding-left: 16px;
      padding-right: 0;
      width: min(260px, 72vw);
    }
  }
  .bb-file-list li:hover .bb-section-note {
    display: block;
  }
  .bb-section-note .bb-sticky-cover {
    display: block;
    width: 88px;
    margin: 0 0 8px;
  }
</style>
