---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="作品 · lszbf.com">
  <main class="works-page">
    <div class="works-header">
      <h1 class="works-title">作品</h1>
      <p class="works-sub">开发项目 ×4 · 四段式</p>
    </div>

    <div class="works-grid">
      {
        projects.map((p) => (
          <a href={`/works/${p.slug}`} class="work-card">
            {p.media?.cover ? (
              <img class="work-card-cover" src={p.media.cover} alt={p.name} loading="lazy" />
            ) : (
              <div class="work-card-ph">{p.name.slice(0, 1)}</div>
            )}
            <div class="work-card-body">
              <h2 class="work-card-name">{p.name}</h2>
              <p class="work-card-meta">{p.role} · {p.period}</p>
              {p.metrics && (
                <span class="work-card-metric">{p.metrics.map((m) => m.note).join(" · ")}</span>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
