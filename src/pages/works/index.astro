---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
---
<BaseLayout title="作品 · lszbf.com">
  <main class="pt-24 px-6 max-w-4xl mx-auto min-h-screen">
    <h1 class="text-3xl font-bold text-[#00d9ff]">作品</h1>
    <p class="mt-4 text-white/60">占位页 —— Phase 4 将替换为「电脑桌面拟物系统」。</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <a
            href={`/works/${p.slug}`}
            class="p-5 rounded bg-white/5 border border-white/10 hover:border-[#00d9ff]/50 transition-colors"
          >
            <h2 class="font-bold text-lg">{p.name}</h2>
            <p class="mt-1 text-sm text-white/50">
              {p.role} · {p.period}
            </p>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
